# Optional overrides for docker compose. Every value below is already the default,
# so `docker compose up` works without creating a .env file.
POSTGRES_DB=school_admission
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
# Full backend connection string. Leave it commented out to use the bundled "db" container
# (built from the POSTGRES_* values above); set it to point the backend at another PostgreSQL.
# ConnectionStrings__DefaultConnection=Host=my-db;Port=5432;Database=admission;Username=me;Password=secret
HOLD_DURATION_SECONDS=600
# Database connections per backend process (keep instances x this below PostgreSQL max_connections=100).
DB_MAX_POOL_SIZE=40
# Backend URL used by the browser (must be reachable from the host, not a container name).
VITE_API_BASE_URL=http://localhost:8080
# Origins allowed to call the backend (comma-separated, or *).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5173
